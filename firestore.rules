rules_version = '2';

// Paste these into the Firebase Console: Firestore Database → Rules.
// Every document lives under users/{uid}/... and only that user may read
// or write it. exerciseCatalog is the exception: a shared, app-wide
// exercise library, readable and (for now, pre-launch) writable by any
// signed-in user — tighten write access before a public launch.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /exerciseCatalog/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // TODO: lock down before public launch
    }
  }
}
